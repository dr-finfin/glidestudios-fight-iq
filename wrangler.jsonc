{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glidestudios-fight-iq",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "GEMINI_API_KEY",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "workflows": [
    {
      "name": "fight-iq-story-pipeline",
      "binding": "FIGHT_IQ_STORY_PIPELINE",
      "class_name": "FightIQStoryPipeline"
    }
  ]
}